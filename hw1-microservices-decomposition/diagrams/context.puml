@startuml context
!include <C4/C4_Context>

title Диаграмма контекста: онлайн-заказ сэндвичей

Person(customer, "Клиент", "Заказывает сэндвичи с телефона или из браузера, забирает сам или получает доставкой")
Person(staff, "Сотрудник точки", "Готовит и выдаёт заказы, вносит заказы, пришедшие по факсу")
Person(courier, "Курьер", "Доставляет заказы точки")
Person(owner, "Владелец точки", "Франчайзи: настраивает точку, локальные акции, доставку")
Person(manager, "Менеджер сети", "Ведёт меню и национальные акции")

System(blt, "Система онлайн-заказов", "Приём заказов через интернет, расчёт времени выдачи, доставка, акции, оплата")

System_Ext(maps, "Картографические сервисы", "Маршруты и время в пути с учётом пробок")
System_Ext(psp, "Платёжный провайдер", "Онлайн-оплата картой")
System_Ext(messaging, "Провайдер рассылок", "E-mail, SMS, push")
System_Ext(fax, "Факс-сервис", "Существующий приём заказов по факсу")

Rel(customer, blt, "Заказывает, оплачивает, следит за статусом", "HTTPS")
Rel(staff, blt, "Видит очередь, отмечает готовность, вносит заказы", "HTTPS")
Rel(courier, blt, "Получает назначения, отмечает доставку", "HTTPS")
Rel(owner, blt, "Настраивает точку и локальные акции", "HTTPS")
Rel(manager, blt, "Ведёт меню и национальные акции", "HTTPS")

Rel(blt, maps, "Запрашивает маршрут и время в пути", "HTTPS")
Rel(blt, psp, "Проводит платежи", "HTTPS")
Rel(blt, messaging, "Отправляет уведомления", "HTTPS")
Rel(fax, staff, "Приносит заказы на бумаге")

SHOW_LEGEND()
@enduml
