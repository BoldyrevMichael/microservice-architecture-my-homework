{
  "info": {
    "name": "hw7 заказ: пользователь, биллинг, заказ, уведомления",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "arch.homework" },
    { "key": "username", "value": "" }, { "key": "password", "value": "" },
    { "key": "token", "value": "" }, { "key": "userId", "value": "" },
    { "key": "order1", "value": "" }, { "key": "order2", "value": "" }
  ],
  "item": [
    {
      "name": "1. Регистрация пользователя (создаёт счёт в биллинге)",
      "event": [
        { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
          "pm.collectionVariables.set('username', pm.variables.replaceIn('{{$randomUserName}}') + Date.now());",
          "pm.collectionVariables.set('password', pm.variables.replaceIn('{{$randomPassword}}'));"
        ] } },
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test('status 201', () => pm.response.to.have.status(201));",
          "pm.collectionVariables.set('userId', pm.response.json().id);"
        ] } }
      ],
      "request": {
        "method": "POST", "url": "http://{{baseUrl}}/register",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"firstName\": \"{{$randomFirstName}}\",\n  \"lastName\": \"{{$randomLastName}}\",\n  \"email\": \"{{$randomEmail}}\",\n  \"phone\": \"+7{{$randomPhoneNumber}}\"\n}" }
      }
    },
    {
      "name": "2. Вход",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('status 200', () => pm.response.to.have.status(200));",
        "pm.collectionVariables.set('token', pm.response.json().token);"
      ] } }],
      "request": {
        "method": "POST", "url": "http://{{baseUrl}}/login",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"username\": \"{{username}}\", \"password\": \"{{password}}\"}" }
      }
    },
    {
      "name": "3. Счёт создан, баланс 0",
      "event": [
        { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
          "// счёт заводится по событию из Kafka, даём ему секунду",
          "setTimeout(() => {}, 1500);"
        ] } },
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test('status 200', () => pm.response.to.have.status(200));",
          "pm.test('own account with zero balance', () => {",
          "  const a = pm.response.json();",
          "  pm.expect(a.userId).to.eql(Number(pm.collectionVariables.get('userId')));",
          "  pm.expect(Number(a.balance)).to.eql(0);",
          "});"
        ] } }
      ],
      "request": { "method": "GET", "url": "http://{{baseUrl}}/billing/account", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] }
    },
    {
      "name": "4. Пополнение счёта на 100",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('status 200', () => pm.response.to.have.status(200));",
        "pm.test('balance 100', () => pm.expect(Number(pm.response.json().balance)).to.eql(100));"
      ] } }],
      "request": {
        "method": "POST", "url": "http://{{baseUrl}}/billing/account/deposit",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
        "body": { "mode": "raw", "raw": "{\"amount\": 100}" }
      }
    },
    {
      "name": "5. Заказ на 60 — денег хватает",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('status 201', () => pm.response.to.have.status(201));",
        "pm.test('order NEW', () => pm.expect(pm.response.json().status).to.eql('NEW'));",
        "pm.collectionVariables.set('order1', pm.response.json().id);"
      ] } }],
      "request": {
        "method": "POST", "url": "http://{{baseUrl}}/orders",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
        "body": { "mode": "raw", "raw": "{\"price\": 60}" }
      }
    },
    {
      "name": "6. Деньги списаны, баланс 40",
      "event": [
        { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [ "setTimeout(() => {}, 2000);" ] } },
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test('status 200', () => pm.response.to.have.status(200));",
          "pm.test('balance 40', () => pm.expect(Number(pm.response.json().balance)).to.eql(40));"
        ] } }
      ],
      "request": { "method": "GET", "url": "http://{{baseUrl}}/billing/account", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] }
    },
    {
      "name": "7. Заказ оплачен",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('status 200', () => pm.response.to.have.status(200));",
        "pm.test('order PAID', () => pm.expect(pm.response.json().status).to.eql('PAID'));"
      ] } }],
      "request": { "method": "GET", "url": "http://{{baseUrl}}/orders/{{order1}}", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] }
    },
    {
      "name": "8. Письмо об оплате отправлено",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('status 200', () => pm.response.to.have.status(200));",
        "const list = pm.response.json();",
        "pm.test('one happy letter for order 1', () => {",
        "  pm.expect(list.length).to.eql(1);",
        "  pm.expect(list[0].subject).to.eql('Заказ ' + pm.collectionVariables.get('order1') + ' оплачен');",
        "});"
      ] } }],
      "request": { "method": "GET", "url": "http://{{baseUrl}}/notifications", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] }
    },
    {
      "name": "9. Заказ на 100 — денег не хватает",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('status 201', () => pm.response.to.have.status(201));",
        "pm.collectionVariables.set('order2', pm.response.json().id);"
      ] } }],
      "request": {
        "method": "POST", "url": "http://{{baseUrl}}/orders",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
        "body": { "mode": "raw", "raw": "{\"price\": 100}" }
      }
    },
    {
      "name": "10. Баланс не изменился, 40",
      "event": [
        { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [ "setTimeout(() => {}, 2000);" ] } },
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test('status 200', () => pm.response.to.have.status(200));",
          "pm.test('balance still 40', () => pm.expect(Number(pm.response.json().balance)).to.eql(40));"
        ] } }
      ],
      "request": { "method": "GET", "url": "http://{{baseUrl}}/billing/account", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] }
    },
    {
      "name": "11. Заказ отклонён",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('status 200', () => pm.response.to.have.status(200));",
        "const o = pm.response.json();",
        "pm.test('order REJECTED with reason', () => { pm.expect(o.status).to.eql('REJECTED'); pm.expect(o.reason).to.eql('insufficient funds'); });"
      ] } }],
      "request": { "method": "GET", "url": "http://{{baseUrl}}/orders/{{order2}}", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] }
    },
    {
      "name": "12. Письмо об отказе отправлено",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('status 200', () => pm.response.to.have.status(200));",
        "const list = pm.response.json();",
        "pm.test('two letters, newest is the sad one', () => {",
        "  pm.expect(list.length).to.eql(2);",
        "  pm.expect(list[0].subject).to.eql('Заказ ' + pm.collectionVariables.get('order2') + ' отклонён');",
        "  pm.expect(list[0].body).to.include('insufficient funds');",
        "});"
      ] } }],
      "request": { "method": "GET", "url": "http://{{baseUrl}}/notifications", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] }
    }
  ]
}
